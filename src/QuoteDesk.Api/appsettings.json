  },
  "Llm": {
    "Provider": "gemini",
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "ApiKey": "",
    "Model": "gemini-3.6-flash",
    "ExtractModel": "gemini-3.5-flash-lite",
