  },
  "Auth": {
    "Google": {
      "ClientId": ""
    },
    "Jwt": {
      "SigningKey": "",
      "Issuer": "quotedesk",
      "Audience": "quotedesk",
      "LifetimeHours": 8
    },
    "AdminEmails": [],
