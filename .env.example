# Read by docker-compose.yml's `api` service (env_file). Copy this file to `.env` and fill in real
# values — never commit `.env` (see .gitignore's secrets block).
#
# ConnectionStrings__QuoteDesk, Database__MigrateOnStartup and Database__SeedOnStartup are already
# set directly in docker-compose.yml and don't belong here — only secrets with no safe default do.

# Google Cloud Console -> Credentials -> OAuth client ID -> Web application.
Auth__Google__ClientId=

# Any random string >= 32 bytes — e.g. `openssl rand -base64 32`. Signs the Api's own short-lived JWT.
Auth__Jwt__SigningKey=

# The Google account email that should sign in with the admin role.
Auth__AdminEmails__0=

# From `dotnet user-secrets set "Llm:ApiKey" "<key>"` locally, or Google AI Studio directly.
Llm__ApiKey=

# Only needed if you want a different sa password than docker-compose.yml's own default
# (QuoteDesk!Local1) for the sql service.
# MSSQL_SA_PASSWORD=
